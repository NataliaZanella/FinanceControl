@page "/importar"
@namespace FinanceControl.SharedUI.Components.Pages
@using FinanceControl.SharedUI.Components
@using Microsoft.AspNetCore.Components.Forms
@inject IImportacaoExcelService Importador

<PageTitle>FinanceControl | Importar Excel</PageTitle>

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand"><span class="brand-mark">F</span> Finance<span>Control</span></div>
        <div class="side-label">ÁREA FINANCEIRA</div>
        <a class="nav-link" href="/">◈ &nbsp; Visão geral</a>
        <a class="nav-selected nav-selected-link" href="/importar">▤ &nbsp; Importar Excel</a>
        <a class="nav-link" href="/valores-a-receber">↙ &nbsp; Valores a receber</a>
        <a class="nav-link" href="/categorias">▦ &nbsp; Categorias</a>
        <div class="sidebar-note">Prévia e revisão antes de salvar. Seu arquivo original não é alterado.</div>
        <div class="sidebar-foot">C# · Blazor · SQLite<br />Versão local de desenvolvimento</div>
    </aside>
    <main class="main-content">
        <header class="topbar"><div><div class="eyebrow">IMPORTAÇÃO SEGURA</div><h1>Importar sua planilha <span>✦</span></h1><p>Selecione uma ou várias abas e revise os itens antes de salvar.</p></div><a class="mini-btn nav-back" href="/">← Voltar ao painel</a></header>
        @if (!string.IsNullOrWhiteSpace(Erro)) { <div class="alert alert-error" role="alert">@Erro</div> }
        @if (!string.IsNullOrWhiteSpace(Sucesso)) { <div class="alert alert-success" role="status">@Sucesso</div> }
        <section class="panel import-intro">
            <div class="panel-heading"><div><div class="section-kicker">PASSO 1</div><h2>Escolher arquivo e abas</h2></div><div class="panel-icon">▤</div></div>
            <div class="form-field"><label for="arquivo">Selecione seu arquivo .xlsx (até 12 MB)</label><InputFile id="arquivo" OnChange="AoSelecionarArquivo" accept=".xlsx" disabled="@Processando" /></div>
            <p class="field-note">O Excel original não é alterado. Os registros entram como previstos, sem pagamentos ou recebimentos automáticos.</p>
            @if (Abas.Count > 0)
            {
                <fieldset class="entry-fields import-controls" disabled="@Processando">
                    <legend>Abas para importar</legend>
                    <div class="entry-actions"><button class="mini-btn" type="button" @onclick="() => SelecionarAbas(true)">Selecionar abas mensais</button><button class="mini-btn" type="button" @onclick="() => SelecionarAbas(false)">Desmarcar todas</button></div>
                    <div class="import-sheet-list">
                        @foreach (var aba in Abas)
                        {
                            <div class="import-sheet-option" @key="aba.Info.Nome">
                                <label class="filter-check" for="@($"aba-{aba.Chave}")"><input id="@($"aba-{aba.Chave}")" type="checkbox" @bind="aba.Selecionada" @bind:after="InvalidarPrevia" disabled="@(!aba.Info.Suportada)" /><strong>@aba.Info.Nome</strong></label>
                                @if (!aba.Info.Suportada) { <span class="small-muted">Formato não suportado · revisão individual</span> }
                                else if (aba.Info.TemAno) { <span class="small-muted">Competência @($"{aba.Info.Mes:00}/{aba.Info.Ano}")</span> }
                                else if (aba.Selecionada)
                                {
                                    <div class="form-field import-year"><label for="@($"ano-{aba.Chave}")">Ano desta aba (obrigatório)</label><input id="@($"ano-{aba.Chave}")" type="number" min="2000" max="2100" @bind="aba.AnoManual" @bind:after="InvalidarPrevia" /></div>
                                }
                            </div>
                        }
                    </div>
                    <div class="import-actions"><p class="field-note">@Abas.Count(x => x.Selecionada) abas selecionadas. Até 100 abas e 20.000 linhas por prévia; até 2.000 registros por confirmação. Abas sem ano exigem preenchimento individual. A aba de dívidas permanece bloqueada.</p><button class="primary-btn" type="button" @onclick="GerarPreviaAsync" disabled="@(!Abas.Any(x => x.Selecionada))">@(Processando ? "Analisando..." : "Gerar prévia das abas selecionadas") <span>→</span></button></div>
                </fieldset>
            }
        </section>
        @if (Previas.Count > 0)
        {
            <section class="panel import-intro">
                <div class="panel-heading"><div><div class="section-kicker">PASSO 2 · REVISÃO DO LOTE</div><h2>@Previas.Count abas analisadas</h2></div><span class="count-pill">@Linhas.Count() linhas encontradas</span></div>
                <div class="import-stats"><span><strong>@Selecionadas</strong> selecionadas no lote</span><span><strong>@Linhas.Count(x => x.Duplicada)</strong> possíveis duplicadas</span><span><strong>@Linhas.Count(x => x.Bloqueada)</strong> com valor inválido/ausente</span></div>
                <div class="form-field"><label for="aba-revisao">Revisar aba</label><select id="aba-revisao" @bind="AbaRevisao" disabled="@Processando">@foreach (var previa in Previas) { <option value="@previa.Aba">@previa.Aba · @previa.Competencia.ToString("MM/yyyy") · @previa.Linhas.Count(x => x.Selecionada && !x.Bloqueada && !x.Duplicada) selecionadas</option> }</select></div>
                <p class="field-note">As marcações e datas ficam preservadas enquanto você alterna as abas da prévia. Alterar a seleção de abas ou seus anos exige gerar uma nova prévia.</p>
            </section>
            @if (PreviaAtual is { } atual)
            {
                <PreviaAbaImportacao @key="atual" Previa="atual" Processando="Processando" AoAlterarSelecao="StateHasChanged" />
            }
            <section class="panel import-intro import-batch-confirm">
                <div class="section-kicker">PASSO 3 · CONFIRMAÇÃO</div>
                @if (Selecionadas > 2000) { <p class="import-info" role="alert">O limite é 2.000 registros por confirmação, somando todas as abas. Desmarque itens ou selecione menos abas para continuar.</p> }
                <div class="import-actions"><p class="field-note">Confira todas as abas antes de confirmar. Cada registro mantém sua competência. O lote é salvo em uma transação; uma falha de gravação reverte todas as abas.</p><button class="primary-btn" type="button" @onclick="ConfirmarAsync" disabled="@(Processando || Selecionadas == 0 || Selecionadas > 2000)">@(Processando ? "Salvando..." : $"Confirmar importação de {Selecionadas} registros") <span>→</span></button></div>
            </section>
        }
        <footer class="footer">FinanceControl • Importação local com prévia • Uma ou várias abas</footer>
    </main>
</div>

@code {
    private const long MaxArquivo = 12 * 1024 * 1024;
    private byte[]? Arquivo;
    private string NomeArquivo = "", AbaRevisao = "";
    private List<OpcaoAba> Abas = [];
    private IReadOnlyList<PreviaImportacaoDto> Previas = [];
    private PreviaImportacaoDto? PreviaAtual => Previas.FirstOrDefault(x => x.Aba == AbaRevisao);
    private IEnumerable<LinhaImportacaoDto> Linhas => Previas.SelectMany(x => x.Linhas);
    private int Selecionadas => Linhas.Count(x => x.Selecionada && !x.Bloqueada && !x.Duplicada);
    private bool Processando;
    private string? Erro, Sucesso;

    private void InvalidarPrevia() { Previas = []; AbaRevisao = ""; Erro = Sucesso = null; }
    private void SelecionarAbas(bool selecionar)
    {
        foreach (var aba in Abas) aba.Selecionada = selecionar && aba.Info.Suportada;
        InvalidarPrevia();
    }

    private async Task AoSelecionarArquivo(InputFileChangeEventArgs e)
    {
        if (Processando) return;
        InvalidarPrevia(); Arquivo = null; Abas = []; Processando = true;
        try
        {
            var file = e.File;
            if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase)) throw new ArgumentException("Selecione um arquivo .xlsx válido.");
            if (file.Size > MaxArquivo) throw new ArgumentException("Arquivo maior que 12 MB.");
            await using var origem = file.OpenReadStream(MaxArquivo);
            using var destino = new MemoryStream();
            await origem.CopyToAsync(destino);
            Arquivo = destino.ToArray(); NomeArquivo = file.Name;
            Abas = Importador.ListarAbas(Arquivo).Select(x => new OpcaoAba(x)).ToList();
            var primeira = Abas.FirstOrDefault(x => x.Info.Suportada && x.Info.TemAno) ?? Abas.FirstOrDefault(x => x.Info.Suportada);
            if (primeira is not null) primeira.Selecionada = true;
        }
        catch (Exception ex) { Erro = ex.Message; }
        finally { Processando = false; }
    }

    private Task GerarPreviaAsync() => CarregarPreviasAsync(false);
    private async Task CarregarPreviasAsync(bool manterSucesso)
    {
        if (Arquivo is null || Processando) return;
        Erro = null; Previas = []; if (!manterSucesso) Sucesso = null;
        Processando = true;
        try
        {
            var selecoes = Abas.Where(x => x.Selecionada).Select(x => new SelecaoAbaImportacaoRequest(x.Info.Nome, x.AnoManual)).ToList();
            Previas = await Importador.PrepararPreviasAsync(Arquivo, NomeArquivo, selecoes);
            AbaRevisao = Previas.FirstOrDefault()?.Aba ?? "";
            if (manterSucesso) foreach (var linha in Linhas) linha.Selecionada = false;
        }
        catch (Exception ex) { Erro = manterSucesso ? "O lote foi salvo, mas não foi possível atualizar a prévia: " + ex.Message : ex.Message; }
        finally { Processando = false; }
    }

    private async Task ConfirmarAsync()
    {
        if (Processando || Selecionadas is 0 or > 2000) return;
        Processando = true; Erro = Sucesso = null;
        try
        {
            var resultado = await Importador.ConfirmarAsync(Linhas.ToList());
            Sucesso = $"Importação concluída: {resultado.Importadas} registros cadastrados, {resultado.Duplicadas} duplicados ignorados e {resultado.Ignoradas} inválidos ignorados. " +
                "Confira o painel no mês de cada aba. As seleções foram limpas; revise novamente antes de outra confirmação.";
        }
        catch (Exception ex) { Erro = "Não foi possível importar: " + ex.Message; }
        finally { Processando = false; }
        if (Sucesso is not null) await CarregarPreviasAsync(true);
    }

    private sealed class OpcaoAba(AbaImportacaoDto info)
    {
        public Guid Chave { get; } = Guid.NewGuid();
        public AbaImportacaoDto Info { get; } = info;
        public bool Selecionada { get; set; }
        public int? AnoManual { get; set; }
    }
}
